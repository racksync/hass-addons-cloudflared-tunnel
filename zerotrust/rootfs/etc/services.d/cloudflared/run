#!/usr/bin/with-contenv bashio

# Enable strict error handling
set -e

TOKEN=$(bashio::config 'token')
PROTOCOL=$(bashio::config 'protocol')
METRICS_ENABLED=$(bashio::config 'metrics_enabled')
METRICS_PORT=$(bashio::config 'metrics_port')

bashio::log.info "Starting Cloudflare Tunnel Services"
bashio::log.info "Made with Love from Thailand, Bring to you by RACKSYNC 🇹🇭"
bashio::log.info "Using protocol: $PROTOCOL"

if bashio::config.true 'metrics_enabled'; then
    bashio::log.info "Metrics enabled - configuring cloudflared to expose metrics on 0.0.0.0:$METRICS_PORT"
    METRICS_FLAG="--metrics 0.0.0.0:$METRICS_PORT"
    bashio::log.info "Cloudflared will bind metrics to all interfaces on port $METRICS_PORT"
else
    bashio::log.info "Metrics disabled - cloudflared will use default metrics (localhost only)"
    METRICS_FLAG=""
fi

# Test metrics connectivity if enabled
if bashio::config.true 'metrics_enabled'; then
    # Wait a moment for cloudflared to start with metrics
    (sleep 5 &&
    if command -v curl >/dev/null 2>&1; then
        if curl -s --max-time 3 "http://0.0.0.0:$METRICS_PORT/metrics" >/dev/null 2>&1; then
            bashio::log.info "✓ Cloudflared metrics successfully accessible on port $METRICS_PORT"
        else
            bashio::log.warning "⚠ Cloudflared metrics not yet accessible on port $METRICS_PORT (may still be starting)"
        fi
    fi) &
fi

mkdir -p /root/.cloudflared/

# Validate configuration before starting
if bashio::config.true 'config'; then
    if [[ ! -f /ssl/config.yaml ]]; then
        bashio::log.fatal "Config mode enabled but /ssl/config.yaml not found!"
        bashio::log.fatal "Please upload your Cloudflare tunnel config.yaml to /ssl/ directory"
        exit 1
    fi
else
    if [[ -z "$TOKEN" ]]; then
        bashio::log.fatal "No token provided and config mode is disabled!"
        bashio::log.fatal "Please provide either a tunnel token or enable config mode with a config.yaml file"
        exit 1
    fi
fi


if bashio::config.true 'no_autoupdate'; then
   NOUPDATE="--no-autoupdate"
else
   NOUPDATE=" "
fi

PROTOCOL_FLAG="--protocol $PROTOCOL"

if bashio::config.true 'config'; then
    bashio::log.info "Fetching tunnel data from config.yaml 🔧"
    if ! cp -Rv /ssl/config.yaml /root/.cloudflared/; then
        bashio::log.fatal "Failed to copy config.yaml from /ssl/"
        exit 1
    fi
    bashio::log.info "Starting cloudflared with config file"
    exec cloudflared tunnel $PROTOCOL_FLAG $NOUPDATE $METRICS_FLAG --config /root/.cloudflared/config.yaml run
else
    bashio::log.info "Fetching tunnel data from Token! 🔑"
    bashio::log.info "Starting cloudflared with token authentication"
    exec cloudflared tunnel $PROTOCOL_FLAG $NOUPDATE $METRICS_FLAG run --token "$TOKEN"
fi